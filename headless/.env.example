# ── Facebook ──
FB_PAGE_URL=https://www.facebook.com/politician
FB_PAGE_ID=

# ── Rate limit mode: paranoid | moderate | aggressive ──
RATE_MODE=paranoid

# ── Date range (YYYY-MM-DD or "all") ──
# DATE_FROM=2023-01-01
# DATE_TO=all

# ── Paths (defaults are relative to project root) ──
# DATA_DIR=./data
# LOGS_DIR=./logs
# PROFILE_DIR=./profile
# DB_PATH=./data/invitations.json
# POSTS_PATH=./data/posts.json
# RATE_LIMIT_PATH=./data/rate-limit-state.json

# ── Browser ──
HEADLESS=true
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# PUPPETEER_EXECUTABLE_PATH=
# PUPPETEER_PROTOCOL_TIMEOUT=300000
